{
  "name": "qr-scanner",
  "version": "1.0.0",
  "description": "跨平台二维码扫描工具 - 支持快捷键截图识别二维码",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build:win": "electron-builder --win",
    "build:mac": "electron-builder --mac",
    "build:linux": "electron-builder --linux"
  },
  "keywords": ["qrcode", "scanner", "screenshot", "electron"],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "electron": "^27.0.0",
    "electron-builder": "^24.6.4"
  },
  "dependencies": {
    "electron-store": "^8.1.0",
    "jsqr": "^1.4.0"
  },
  "build": {
    "appId": "com.qrscanner.app",
    "productName": "QR Scanner",
    "publish": null,
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": ["nsis"],
      "icon": "assets/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "QR Scanner",
      "uninstallDisplayName": "QR Scanner - 二维码扫描工具",
      "installerIcon": "assets/icon.png",
      "uninstallerIcon": "assets/icon.png",
      "license": "LICENSE.txt",
      "menuCategory": true
    },
    "mac": {
      "target": ["dmg"],
      "icon": "assets/icon.png",
      "category": "public.app-category.utilities"
    },
    "linux": {
      "target": ["AppImage", "deb"],
      "category": "Utility"
    }
  }
}
